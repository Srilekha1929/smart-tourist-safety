# Flask Backend Environment Variables Example
SECRET_KEY=change-to-a-secure-secret-key-for-production
JWT_SECRET_KEY=change-to-a-secure-jwt-secret-key-2026
PORT=5000

# Default Admin Credentials
ADMIN_EMAIL=admin@touristsafety.org
ADMIN_PASSWORD=admin123

# Database configuration (defaults to SQLite tourist_safety.db)
# To use MongoDB instead: MONGODB_URI=mongodb://localhost:27017/tourist_safety
DATABASE_PATH=tourist_safety.db
